    { path: 'web/types.ts', text: "export type PartnerStatus =\n  | 'ACTIVE'\n  | 'SUSPENDED';\nexport const PARTNER_STATUS_OPTIONS = ['ACTIVE', 'SUSPENDED'] as const;" },
