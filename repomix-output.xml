import { describe, expect, it, vi } from 'vitest';
import {
  cleanSpeechText,
  evaluateDuck,
  evaluateExplanation,
  evaluateQuickFire,
  filterNaturalVoices,
  firstAppFrame,
  looksLikeHistory,
  preferredSpeakVoices,
  rootsForSelection,
  parseDrillVerdict,
  codeAnchors,
  groundedInCode,
  localImprovements,
  parseImprovements,
  parsePocIdeas,
  parseSolver,
} from '../shared/evaluator';
